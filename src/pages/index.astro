<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RANL</title>
    <meta name="description" content="Site em construção." />
    <link rel="canonical" href="https://ranl.com.br/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RANL" />
    <meta property="og:title" content="RANL" />
    <meta property="og:description" content="Site em construção." />
    <meta property="og:url" content="https://ranl.com.br/" />
    <meta property="og:locale" content="pt_BR" />

    <link rel="icon" href="/marca.png" type="image/png" />
    <link rel="apple-touch-icon" href="/marca.png" />
    <meta name="theme-color" content="#f05e4f" />
  </head>

  <body>
    <main>
      <img class="marca" src="/ranl.png" alt="RANL" width="350" height="95" />
      <p>Site em construção.</p>
    </main>

    <style is:global>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
      }

      body {
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px;
        background: linear-gradient(135deg, #fff6f4, #fffaf8 55%, #fdf7f5);
        color: #241715;
        font-family:
          ui-sans-serif, -apple-system, "SF Pro Text", "Inter", "Segoe UI", system-ui, sans-serif;
        text-align: center;
        -webkit-font-smoothing: antialiased;
      }

      main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
      }

      .marca {
        width: min(280px, 72vw);
        height: auto;
      }

      p {
        margin: 0;
        font-size: 15.5px;
        color: #6d5450;
      }

    </style>
  </body>
</html>
